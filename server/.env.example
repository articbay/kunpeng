# Local development example. Copy to .env and replace all REPLACE_ME values.
DATABASE_URL=mysql+asyncmy://kunpeng:REPLACE_ME_DB_PASSWORD@127.0.0.1:3306/kunpeng_demo?charset=utf8mb4
SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_64_CHARACTER_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

APP_NAME=Kunpeng Cross-border E-commerce System
DEBUG=false
ENVIRONMENT=development
AUTO_CREATE_TABLES=true
JOBS_ENABLED=false
RUN_SCHEDULER=false

# Optional external services. Keep empty for an offline demo.
WB_API_KEY=
OZON_PERFORMANCE_CLIENT_ID=
OZON_PERFORMANCE_CLIENT_SECRET=
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_SECRET_KEY=
